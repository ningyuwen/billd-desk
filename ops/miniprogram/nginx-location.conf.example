# Insert into the existing HTTPS server block only after reviewing the deployment.
# Configure this server's origin as the mini-program's socket legal domain.
location /mini-control/ {
    proxy_pass http://127.0.0.1:4311;
    proxy_http_version 1.1;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection "upgrade";
    proxy_set_header Host $host;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
    proxy_buffering off;
    access_log off;
}
