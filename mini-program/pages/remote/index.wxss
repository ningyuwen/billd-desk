page {
  background: #f6f8fc;
  color: #17243b;
}
.page {
  padding: 28rpx;
  padding-bottom: calc(28rpx + env(safe-area-inset-bottom));
}
.title {
  display: block;
  font-size: 38rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}
.hint {
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  color: #607087;
  margin: 18rpx 0;
}
input,
textarea {
  box-sizing: border-box;
  width: 100%;
  background: white;
  border: 1px solid #d8dfeb;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 18rpx 0;
}
input {
  height: 88rpx;
}
textarea {
  height: 150rpx;
}
.status {
  display: block;
  margin: 20rpx 0;
  font-size: 26rpx;
}
.screen {
  width: 100%;
  height: 420rpx;
  background: black;
  border-radius: 8rpx;
}
.row {
  display: flex;
  gap: 10rpx;
  flex-wrap: wrap;
}
.row button {
  margin: 6rpx 0;
}
